<Window x:Class="ForgingDwarf.Client.NewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForgingDwarf.Client"
        mc:Ignorable="d"
        Title="NewOrderWindow" Height="450" Width="800">
    <StackPanel Margin="10">
        <Label>Клиент:</Label>
        
        <ComboBox x:Name="ClientIdComboBox"
          DisplayMemberPath="Id"
            SelectedValuePath="Id"
            IsEditable="False"
            Width="200"/>


        <Label>ID:</Label>
        <TextBox x:Name="IdTextBox"/>

        <Label>Тип изделия:</Label>
        <ComboBox x:Name="ItemTypeComboBox">
            <ComboBoxItem>Оружие</ComboBoxItem>
            <ComboBoxItem>Ворота</ComboBoxItem>
            <ComboBoxItem>Скульптура</ComboBoxItem>
            <ComboBoxItem>Средневековая броня</ComboBoxItem>
            <ComboBoxItem>Броня эпохи возрождения</ComboBoxItem>
        </ComboBox>

        <Label>Тип стали:</Label>
        <ComboBox x:Name="SteelTypeComboBox">
            <ComboBoxItem>Дамасская</ComboBoxItem>
            <ComboBoxItem>Мозаичная</ComboBoxItem>
            <ComboBoxItem>Тигельная</ComboBoxItem>
        </ComboBox>

        <Label>Стиль:</Label>
        <ComboBox x:Name="StyleComboBox">
            <ComboBoxItem>Готика</ComboBoxItem>
            <ComboBoxItem>Фэнтези</ComboBoxItem>
            <ComboBoxItem>Исторический</ComboBoxItem>
        </ComboBox>
        <CheckBox x:Name="IsCustomChekBox">
            Индивидуальный
        </CheckBox>

        <Button Content="Создать" Margin="0,20" Click="Create_Click"/>
    </StackPanel>
</Window>
