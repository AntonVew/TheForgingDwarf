<Window x:Class="ForgingDwarf.Client.CreateOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForgingDwarf.Client"
        mc:Ignorable="d"
        Title="CreateOrderWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Клиент:"/>
        <ComboBox x:Name="ClientCombo" DisplayMemberPath="Name"/>

        <TextBlock Text="Тип изделия:"/>
        <ComboBox x:Name="ItemTypeCombo"/>

        <TextBlock Text="Тип стали:"/>
        <ComboBox x:Name="SteelTypeCombo"/>

        <TextBlock Text="Стиль:"/>
        <ComboBox x:Name="StyleCombo"/>

        <TextBlock Text="Статус:"/>
        <ComboBox x:Name="StatusCombo"/>

        <CheckBox x:Name="IsCustomCheck" Content="Индивидуальный заказ" Margin="0 10"/>

        <TextBlock Text="Цена:"/>
        <TextBox x:Name="PriceTextBox"/>

        <Button Content="Создать" Click="CreateButton_Click" Margin="0 20" Padding="10"/>
    </StackPanel>
</Window>
