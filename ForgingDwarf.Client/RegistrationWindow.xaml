<Window x:Class="ForgingDwarf.Client.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForgingDwarf.Client"
        mc:Ignorable="d"
        Title="RegistrationWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <Label>Имя*</Label>
        <TextBox x:Name="NameBox"/>
        <Label>Пароль*</Label>
        <PasswordBox x:Name="PasswordBox"/>
        <Label>Подтвердите пароль*</Label>
        <PasswordBox x:Name="ConfirmPasswordBox"/>

        <Label>Email</Label>
        <TextBox x:Name="EmailBox"/>
        <Label>Телефон</Label>
        <TextBox x:Name="PhoneBox"/>

        <Button Content="Зарегистрироваться" Click="RegisterButton_Click"/>
        <Button Content="Отмена" Click="CancelButton_Click"/>
    </StackPanel>
</Window>
