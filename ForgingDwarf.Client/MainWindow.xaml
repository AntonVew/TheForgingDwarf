<Window x:Class="ForgingDwarf.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Forging Dwarf" Height="600" Width="800">
    <DockPanel>
        <!-- Верхняя панель с кнопками -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
            <Button Content="Новый заказ" Width="100" Margin="5" Click="NewOrder_Click"/>
            <Button Content="Новый клиент" Width="100" Margin="5" Click="NewClient_Click"/>
            <Button Content="Обновить" Width="100" Margin="5" Click="Refresh_Click"/>
        </StackPanel>

        <!-- Список заказов -->
        <DataGrid x:Name="OrdersGrid" DockPanel.Dock="Top" 
                 AutoGenerateColumns="False" Margin="5"
                 IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientId}" Width="*"/>
                <DataGridTextColumn Header="Тип изделия" Binding="{Binding ItemType}" Width="*"/>
                <DataGridTextColumn Header="Сталь" Binding="{Binding SteelType}" Width="*"/>
                <DataGridTextColumn Header="Стиль" Binding="{Binding Style}" Width="*"/>
                <DataGridTextColumn Header="Индивидуальный" Binding="{Binding Style}" Width="*"/>
                <DataGridTextColumn Header="Принят" Binding="{Binding OrderDate}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText">Готово</TextBlock>
            </StatusBarItem>
        </StatusBar>
    </DockPanel>
</Window>